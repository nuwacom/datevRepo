# ============================================================================
# DATEV MCP server (Vercel edition) — configuration
# In Vercel: Project → Settings → Environment Variables. Locally: copy to .env.local
# ============================================================================

# ---- DATEV environment: "sandbox" or "production" ----
# Switches both the login endpoints (login.datev.de/openidsandbox vs /openid)
# and the API base paths (…/platform-sandbox/… vs …/platform/…).
# Note: a DATEV app is upgraded sandbox → production in the developer portal;
# a downgrade back to sandbox is not possible.
DATEV_ENV=sandbox

# ---- OAuth app (DATEV Developer Portal) ----
# developer.datev.de → your Organisation → create an app ("App erstellen").
# The client id is also sent as the X-DATEV-Client-Id header on every API call.
DATEV_CLIENT_ID=
DATEV_CLIENT_SECRET=

# Space-separated scopes (spaces or "+" are the only valid separators, and the
# list must contain at least "openid"). Copy the product scope strings VERBATIM
# from your app / product pages in the portal — DATEV's naming is inconsistent
# across public docs, so no product scopes are pre-filled here.
#
# There are TWO modes, and the choice is architectural:
#
#  A) WITHOUT offline_access (default, multi-Mandant):
#       openid profile email <documents scope> <clients scope>
#     Refresh tokens last max 11 hours, so a human must repeat
#     /api/datev/connect roughly once a working day. All tools work,
#     including list_clients.
#
#  B) WITH offline_access (unattended, ONE Mandant only):
#       openid profile email offline_access datev:iam:client:<consultant>-<client> ...
#     Refresh tokens last 2 years and renew on every use — no daily reconnect.
#     BUT the token is bound to that single Mandant and only works on endpoints
#     that carry the client id in the URL path. list_clients (GET /clients) will
#     NOT work; set DATEV_DEFAULT_CLIENT_ID and use the other tools.
#     DATEV additionally requires you to implement token revocation and to link
#     users to https://apps.datev.de/tokrevui before using this mode.
DATEV_SCOPES=

# Must EXACTLY match a redirect URI registered on the app in the portal.
#
# DATEV's portal enforces these rules (see the tooltip on the Redirect-URL field):
#   * "DATEV" must NOT appear in the DOMAIN — only in the path. So
#     https://datev-mcp.example.com/... is REJECTED, while
#     https://mcp.example.com/api/datev/callback is fine. The /api/datev/
#     path this server uses is deliberately allowed.
#   * https URLs allow no wildcards — register each full URL exactly.
#   * For http, only literally "http://localhost" may be registered; it then
#     acts as a placeholder for any port and path at runtime, so you register
#     "http://localhost" but may use http://localhost:3000/api/datev/callback.
#   * For Confidential clients, localhost / custom / local / internal /
#     development-like URIs are SANDBOX ONLY. Production redirect URIs must
#     point to uniquely resolvable, production-usable domains.
# https://developer.datev.de/de/guides/authentication#anforderungen-an-redirecturls-in-der-produktivumgebung
DATEV_REDIRECT_URI=https://<your-domain-without-datev-in-it>/api/datev/callback

# ---- Optional default client (Mandant) ----
# Used when tools are called without clientId/clientName.
# Format: "{consultant_number}-{client_number}", e.g. 455148-1. Get ids from list_clients.
# DATEV_DEFAULT_CLIENT_ID=

# ---- Optional guard for the connect route ----
# If set, /api/datev/connect requires ?key=<value>. Keeps strangers who find the
# URL from re-binding this server to their own DATEV account.
# Deliberately a separate, low-sensitivity secret — NOT the MCP_AUTH_TOKEN.
# DATEV_CONNECT_KEY=

# ============================================================================
# MCP endpoint security
# ============================================================================
# Shared secret nuwacom must send as "Authorization: Bearer <token>".
# STRONGLY recommended — without it the MCP endpoint is open to anyone.
MCP_AUTH_TOKEN=

# ============================================================================
# Upstash Redis (token persistence)
# ============================================================================
# console.upstash.com → create a Redis database → copy the REST API credentials.
# Required: DATEV refresh tokens must survive serverless cold starts, so the
# in-memory caching that was enough for the UiPath edition is not enough here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
