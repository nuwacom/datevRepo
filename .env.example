# ============================================================================
# DATEV MCP server (Vercel edition) — configuration
# In Vercel: Project → Settings → Environment Variables. Locally: copy to .env.local
# ============================================================================

# ---- DATEV environment: "sandbox" or "production" ----
# Switches both the login endpoints (login.datev.de/openidsandbox vs /openid)
# and the API base paths (…/platform-sandbox/… vs …/platform/…).
# Note: a DATEV app is upgraded sandbox → production in the developer portal;
# a downgrade back to sandbox is not possible.
DATEV_ENV=sandbox

# ---- OAuth app (DATEV Developer Portal) ----
# developer.datev.de → your Organisation → create an app ("App erstellen").
# The client id is also sent as the X-DATEV-Client-Id header on every API call.
DATEV_CLIENT_ID=
DATEV_CLIENT_SECRET=

# Space-separated scopes. Copy the strings VERBATIM from your app / product pages
# in the developer portal — DATEV's scope naming is inconsistent across public
# docs ("accounting:documents" and "datev:accounting:clients" have both been seen
# in the wild), so there is deliberately no pre-filled default here.
# Example shape: openid profile email <documents scope> <clients scope>
DATEV_SCOPES=

# Must EXACTLY match a redirect URI registered on the app in the portal.
# Local development needs its own registered URI, e.g. http://localhost:3000/api/datev/callback
DATEV_REDIRECT_URI=https://<your-app>.vercel.app/api/datev/callback

# ---- Optional default client (Mandant) ----
# Used when tools are called without clientId/clientName.
# Format: "{consultant_number}-{client_number}", e.g. 455148-1. Get ids from list_clients.
# DATEV_DEFAULT_CLIENT_ID=

# ---- Optional guard for the connect route ----
# If set, /api/datev/connect requires ?key=<value>. Keeps strangers who find the
# URL from re-binding this server to their own DATEV account.
# Deliberately a separate, low-sensitivity secret — NOT the MCP_AUTH_TOKEN.
# DATEV_CONNECT_KEY=

# ============================================================================
# MCP endpoint security
# ============================================================================
# Shared secret nuwacom must send as "Authorization: Bearer <token>".
# STRONGLY recommended — without it the MCP endpoint is open to anyone.
MCP_AUTH_TOKEN=

# ============================================================================
# Upstash Redis (token persistence)
# ============================================================================
# console.upstash.com → create a Redis database → copy the REST API credentials.
# Required: DATEV refresh tokens must survive serverless cold starts, so the
# in-memory caching that was enough for the UiPath edition is not enough here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
